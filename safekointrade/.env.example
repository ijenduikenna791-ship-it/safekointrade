# ---------------------------------------------------------------------------
# Copy to .env.local and fill in. NEVER commit .env.local or real secrets.
# "PUBLIC" = safe to expose to the browser. "SECRET" = server only.
# ---------------------------------------------------------------------------

# --- App ------------------------------------------------------------------
# PUBLIC. Full origin of the site, used for email links and auth redirects.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# PUBLIC. Keep "true" until a licensed payment/custody provider is integrated.
# When true, every deposit, withdrawal and investment is labelled as simulated.
NEXT_PUBLIC_DEMO_MODE=true

# --- Supabase (Project Settings -> API Keys) ------------------------------
# PUBLIC. Project URL, e.g. https://abcd1234.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# PUBLIC. Publishable key (sb_publishable_...). Legacy projects: use the anon key
# in NEXT_PUBLIC_SUPABASE_ANON_KEY instead. RLS protects data either way.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SECRET. Secret key (sb_secret_...) or legacy service_role key. Bypasses RLS.
# Server only — never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Transactional email (Resend: resend.com -> API Keys) -----------------
# SECRET. Without it, emails are skipped and logged on the server.
RESEND_API_KEY=
# SECRET-ish. Verified sender, e.g. "SafeKoinTrade <no-reply@yourdomain.com>"
EMAIL_FROM=

# --- Market data (optional) -----------------------------------------------
# SECRET. CoinGecko demo/pro API key. The ticker works without a key on the
# public endpoint (rate limited); it hides itself if the provider is unreachable.
COINGECKO_API_KEY=

# --- Payment provider (not integrated) ------------------------------------
# SECRET. Reserved for a licensed provider's server-side key and webhook secret.
PAYMENT_PROVIDER_SECRET_KEY=
PAYMENT_WEBHOOK_SECRET=

# --- Admin bootstrap (scripts/bootstrap-admin.mjs) -------------------------
# SECRET. One-time token required by the bootstrap script. Remove after setup.
ADMIN_BOOTSTRAP_TOKEN=

# WalletConnect (Reown). Free project ID from https://cloud.reown.com — add your
# site's domain to the project's allowlist. Leave empty to hide "Connect wallet".
NEXT_PUBLIC_REOWN_PROJECT_ID=
